{
  "name": "ledger-lens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "DOTENV_CONFIG_OVERRIDE=true DOTENV_CONFIG_QUIET=true tsx watch -r dotenv/config server/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js",
    "build:all": "npm run build && npm run build:server",
    "start": "DOTENV_CONFIG_OVERRIDE=true DOTENV_CONFIG_QUIET=true node -r dotenv/config dist-server/index.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@hono/node-server": "^2.0.11",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "apexcharts": "^6.5.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.32",
    "react": "^19.2.7",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
